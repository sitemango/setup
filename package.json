{
  "name": "campus-plus",
  "version": "1.0.0",
  "private": true,
  "description": "Campus+ \u2014 an unofficial, text-first digital layer for campus life (PCCOE).",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-proxy-routes.mjs && node scripts/build-sw.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:env": "node scripts/check-env.mjs",
    "seed:dev": "node scripts/seed-dev.mjs",
    "role:grant": "node scripts/grant-role.mjs",
    "role:list": "node scripts/list-roles.mjs",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:bundle": "node scripts/build-sql-bundle.mjs",
    "verify:db": "node scripts/dev/validate-migrations.mjs",
    "audit:db": "node scripts/dev/audit.mjs",
    "perf:serve": "node scripts/dev/perf/serve.mjs",
    "perf:measure": "node scripts/dev/perf/measure.mjs",
    "perf:smoke": "node scripts/dev/perf/smoke.mjs",
    "verify": "npm run lint && npm run sw:check && npm run verify:db && npm run audit:db && npm run test",
    "verify:security": "node scripts/verify-security.mjs",
    "backup:worker": "node scripts/backup/worker.mjs",
    "backup:snapshot": "node scripts/backup/snapshot.mjs",
    "backup:restore": "node scripts/backup/restore.mjs",
    "backup:verify-restore": "node scripts/backup/verify-restore.mjs",
    "backup:disconnect": "node scripts/backup/disconnect.mjs",
    "test:contrast": "node scripts/dev/contrast/audit.mjs",
    "brand:icons": "node scripts/dev/brand-icons.mjs",
    "brand:mark": "node scripts/dev/brand-mark.mjs",
    "brand:timetable-icons": "node scripts/dev/timetable-icons.mjs",
    "sw:bundle": "node scripts/build-sw.mjs",
    "sw:check": "node scripts/build-sw.mjs --check",
    "verify:offline": "node scripts/dev/timetable-offline-check.mjs",
    "verify:feed": "node scripts/dev/feed-refresh-check.mjs",
    "verify:homefeed": "node scripts/dev/home-feed-depth-check.mjs",
    "verify:viewport": "node scripts/dev/mobile-fit-check.mjs",
    "club-logos:register": "node scripts/register-club-logos.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.164.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "embedded-postgres": "18.6.0-beta.19",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.8",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.6.0-beta.19": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
